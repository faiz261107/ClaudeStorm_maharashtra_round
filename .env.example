# Copy this file to .env and put your key after the = sign (no quotes, no spaces).
# .env is in .gitignore, so your key never goes to GitHub.

# Google Gemini (free key: https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Optional: pick a different Gemini model
# RELEARN_LLM_MODEL=gemini-flash-latest

# Teacher tab PIN (default 1234)
# RELEARN_TEACHER_PIN=1234
